{
	"name": "doubleedesign/comet-components",
	"description": "Monorepo for the development of Comet Components",
	"type": "project",
	"version": "0.8.0",
	"authors": [
		{
			"name": "Leesa Ward",
			"email": "leesa@doubleedesign.com.au"
		}
	],
	"autoload": {
		"classmap": [
			"packages/core/src/components/"
		],
		"psr-4": {
			"Doubleedesign\\Comet\\TestUtils\\": [
				"tests/common/",
				"tests/unit"
			],
			"Doubleedesign\\Comet\\Core\\": [
				"packages/core/src/base/types/",
				"packages/core/src/base/attributes/",
				"packages/core/src/base/traits/",
				"packages/core/src/base/annotations/",
				"packages/core/src/base/components/",
				"packages/core/src/base/",
				"packages/core/src/services/"
			]
		}
	},
	"require": {
		"ext-dom": "*",
		"ext-libxml": "*",
		"ext-intl": "*"
	},
	"require-dev": {
		"antecedent/patchwork": "^2.2.3",
		"symfony/var-dumper": "^7.4",
		"pestphp/pest": "4.4.6",
		"mockery/mockery": "^1.6",
		"sirbrillig/spies": "^1.11.0",
		"brain/monkey": "^2.7.0",
		"fakerphp/faker": "^1.24"
	},
	"config": {
		"preferred-install": "source",
		"allow-plugins": {
			"composer/installers": true,
			"pestphp/pest-plugin": true
		}
	}
}
