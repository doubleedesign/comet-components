{
  "name": "comet-components",
  "version": "0.8.0",
  "description": "",
  "author": "Leesa Ward",
  "type": "module",
  "scripts": {
    "storybook": "npx kill-port 6006 && storybook dev --debug -p 6006 --https --ssl-cert .cert/cert.pem --ssl-key .cert/key.pem --host storybook.comet-components.test",
    "build-storybook": "storybook build",
    "docs": "cd docs-site && pnpm run docs:dev",
    "docs:build": "cd docs-site && pnpm run docs:build",
    "generate": "node --import ./scripts/loader.mjs ./scripts/generate.ts",
    "generate:docs": "php scripts/generate-docs.php",
    "generate:stories": "php scripts/generate-stories.php",
    "refresh:composer": "pwsh.exe -File scripts/refresh-composer.ps1",
    "refresh:composer:dev": "pnpm run refresh:composer -local",
    "refresh:autoload": "pnpm run refresh:composer -autoload",
    "refresh:npm": "pwsh.exe -File scripts/refresh-npm.ps1",
    "refresh:npmpackages": "pnpm run refresh:npm -- -packagesOnly",
    "refresh:all": "pnpm run refresh:composer && pnpm run refresh:npm",
    "refresh:all:dev": "pnpm run refresh:composer:dev && pnpm run refresh:npm",
    "test:storybook": "playwright test -c .storybook/playwright.config.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/register": "^7.28.6",
    "@babel/runtime": "8.0.0-alpha.17",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@prettier/plugin-php": "^0.22.4",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-links": "^10.3.5",
    "@storybook/html-vite": "^10.3.5",
    "@storybook/server": "^10.3.5",
    "@stylistic/eslint-plugin-ts": "^2.13.0",
    "@tippyjs/react": "^4.2.6",
    "@types/js-beautify": "^1.14.3",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vuepress/plugin-markdown-container": "2.0.0-rc.128",
    "@wordpress/icons": "^10.32.0",
    "case": "^1.6.3",
    "clsx": "^2.1.1",
    "crypto-browserify": "^3.12.1",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.4",
    "eslint-plugin-storybook": "^10.3.5",
    "eslint-plugin-vue": "^10.8.0",
    "esm": "^3.2.25",
    "highlight.js": "^11.11.1",
    "js-beautify": "^1.15.4",
    "jsdom": "^25.0.1",
    "lodash": "^4.18.1",
    "path-browserify": "^1.0.1",
    "polished": "^4.3.1",
    "prettier": "^3.8.3",
    "storybook": "^10.3.5",
    "stream-browserify": "^3.0.0",
    "tippy.js": "^6.3.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.2",
    "vue-eslint-parser": "^10.4.0"
  },
  "overrides": {
    "storybook": "$storybook"
  },
  "workspaces": [
    "packages/core",
    "docs-site"
  ],
  "dependencies": {
    "vue": "^3.5.33"
  }
}