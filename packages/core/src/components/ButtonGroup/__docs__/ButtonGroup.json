{
    "name": "ButtonGroup",
    "description": "Semantically and visually group buttons together.",
    "extends": "UIComponent",
    "abstract": false,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": [
                "button-group"
            ]
        },
        "colorTheme": {
            "type": "ThemeColor",
            "description": "Colour keyword for theming purposes. May be used for headings, buttons, accents, and other UI elements according to the component implementation.",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white",
                "black"
            ],
            "default": "primary"
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant)."
        },
        "hAlign": {
            "type": "Alignment",
            "description": "Horizontal alignment, if applicable",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ],
            "default": "match-parent"
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "orientation": {
            "type": "Orientation",
            "description": "Orientation of the component content, if applicable",
            "supported": [
                "horizontal",
                "vertical"
            ],
            "default": "horizontal"
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set.",
            "required": true,
            "default": "button-group"
        },
        "style": {
            "type": "array",
            "description": "Inline styles"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "div"
            ],
            "default": "div"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        },
        "vAlign": {
            "type": "Alignment",
            "description": "Vertical alignment, if applicable",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ],
            "default": "match-parent"
        }
    },
    "innerComponents": {
        "type": "array<Button>",
        "description": "Button objects to render inside the ButtonGroup",
        "required": true
    },
    "traits": [
        "ColorTheme",
        "LayoutAlignment",
        "LayoutOrientation",
        "BlockElementModifier"
    ]
}