{
    "name": "CoverImage",
    "description": "*/",
    "extends": "ImageComponent",
    "abstract": false,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "alt": {
            "type": "string",
            "description": "Alternative text",
            "required": true,
            "default": ""
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "supported": [
                "is-style-rounded",
                "breakout"
            ],
            "default": [
                "image"
            ]
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant)."
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "isParallax": {
            "type": "bool",
            "description": "In relevant contexts, whether the image should be used to achieve a parallax effect (requires CSS to actually execute)",
            "required": true,
            "default": "false"
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set.",
            "required": true,
            "default": "image"
        },
        "src": {
            "type": "string",
            "description": "Image source URL",
            "required": true
        },
        "style": {
            "type": "array",
            "description": "Inline styles"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "div"
            ],
            "default": "div"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        },
        "title": {
            "type": "string",
            "description": "Optional image title (appears on hover)"
        }
    }
}