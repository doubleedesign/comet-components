{
    "name": "TableCell",
    "description": null,
    "extends": "TextElement",
    "abstract": false,
    "isInner": true,
    "belongsInside": "Table",
    "attributes": {
        "backgroundColor": {
            "type": "ThemeColor",
            "description": "Background colour keyword",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white",
                "black"
            ]
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": []
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant)."
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set.",
            "required": true,
            "default": ""
        },
        "style": {
            "type": "array",
            "description": "Inline styles"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "td"
            ],
            "default": "td"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        },
        "textAlign": {
            "type": "Alignment",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ]
        },
        "verticalAlign": {
            "type": "string",
            "description": "Vertical alignment of the cell content",
            "supported": [
                "top",
                "middle",
                "bottom"
            ]
        }
    },
    "content": {
        "type": "string",
        "description": "Plain text or basic HTML",
        "required": true
    },
    "innerComponents": {
        "type": "array",
        "required": true
    },
    "traits": [
        "BackgroundColor",
        "BlockElementModifier",
        "TextAlign"
    ]
}