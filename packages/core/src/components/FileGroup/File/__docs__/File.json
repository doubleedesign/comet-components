{
    "name": "File",
    "description": null,
    "extends": "Renderable",
    "abstract": false,
    "isInner": true,
    "belongsInside": "FileGroup",
    "attributes": {
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": [
                "filegroup__file"
            ],
            "inherited": true
        },
        "colorTheme": {
            "type": "ThemeColor",
            "description": "Colour keyword for the fill or outline colour",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white"
            ],
            "default": "null",
            "inherited": false
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant).",
            "default": "filegroup",
            "inherited": false
        },
        "description": {
            "type": "string",
            "inherited": false
        },
        "icon": {
            "type": "string",
            "description": "Icon class name",
            "inherited": false
        },
        "iconPrefix": {
            "type": "string",
            "description": "Icon prefix class name",
            "default": "fa-solid",
            "inherited": false
        },
        "id": {
            "type": "string",
            "description": "Unique identifier",
            "inherited": true
        },
        "mimeType": {
            "type": "string|mixed",
            "description": "MIME type of the file",
            "inherited": false
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set.",
            "required": true,
            "default": "file",
            "inherited": false
        },
        "size": {
            "type": "string",
            "inherited": false
        },
        "style": {
            "type": "array",
            "description": "Inline styles",
            "inherited": true
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "div"
            ],
            "default": "div",
            "inherited": true
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests",
            "inherited": true
        },
        "title": {
            "type": "string",
            "inherited": false
        },
        "uploadDate": {
            "type": "string",
            "inherited": false
        },
        "url": {
            "type": "string",
            "required": true,
            "inherited": false
        }
    }
}