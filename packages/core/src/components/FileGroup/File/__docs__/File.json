{
    "name": "File",
    "description": null,
    "extends": "Renderable",
    "abstract": false,
    "isInner": true,
    "belongsInside": "FileGroup",
    "attributes": {
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": [
                "filegroup__file"
            ]
        },
        "colorTheme": {
            "type": "ThemeColor",
            "description": "Colour keyword for the fill or outline colour",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white"
            ],
            "default": "null"
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant).",
            "default": "filegroup"
        },
        "description": {
            "type": "string"
        },
        "icon": {
            "type": "string",
            "description": "Icon class name"
        },
        "iconPrefix": {
            "type": "string",
            "description": "Icon prefix class name",
            "default": "fa-solid"
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "mimeType": {
            "type": "string|mixed",
            "description": "MIME type of the file"
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set.",
            "required": true,
            "default": "file"
        },
        "size": {
            "type": "string"
        },
        "style": {
            "type": "array",
            "description": "Inline styles"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "div"
            ],
            "default": "div"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        },
        "title": {
            "type": "string"
        },
        "uploadDate": {
            "type": "string"
        },
        "url": {
            "type": "string",
            "required": true
        }
    },
    "traits": [
        "BlockElementModifier",
        "ColorTheme",
        "Icon"
    ]
}