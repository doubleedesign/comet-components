{
    "name": "PageHeader",
    "description": "Render a page header with the page title and optional breadcrumb navigation.",
    "extends": "WrappedLayoutComponent",
    "abstract": false,
    "isInner": false,
    "belongsInside": null,
    "attributes": {
        "backgroundColor": {
            "type": "ThemeColor",
            "description": "Background colour keyword",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white"
            ],
            "inherited": false
        },
        "breadcrumbs": {
            "type": "array",
            "description": "Indexed array of breadcrumb associative arrays with title, URL, and optional boolean 'current' for if this link is the current page",
            "required": true,
            "inherited": false
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": [
                "page-header"
            ],
            "inherited": true
        },
        "colorTheme": {
            "type": "ThemeColor",
            "description": "Colour keyword for the fill or outline colour",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white"
            ],
            "default": "$this->breadcrumbs",
            "inherited": false
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant).",
            "inherited": false
        },
        "hAlign": {
            "type": "Alignment",
            "description": "Horizontal alignment, if applicable",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ],
            "default": "match-parent",
            "inherited": false
        },
        "id": {
            "type": "string",
            "description": "Unique identifier",
            "inherited": true
        },
        "isNested": {
            "type": "bool",
            "description": "Whether this component is nested inside another element; used for simplifying layout and HTML structure handling",
            "required": true,
            "default": false,
            "inherited": false
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set.",
            "required": true,
            "default": "page-header",
            "inherited": false
        },
        "style": {
            "type": "array",
            "description": "Inline styles",
            "inherited": true
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "header",
                "div",
                "section"
            ],
            "default": "header",
            "inherited": true
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests",
            "inherited": true
        },
        "vAlign": {
            "type": "Alignment",
            "description": "Vertical alignment, if applicable",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ],
            "default": "match-parent",
            "inherited": false
        }
    },
    "content": {
        "type": "string",
        "description": "The title of the page",
        "required": true,
        "inherited": false
    },
    "innerComponents": {
        "type": "array<Renderable>",
        "description": "Inner components to be rendered within this component",
        "required": true,
        "inherited": true
    }
}