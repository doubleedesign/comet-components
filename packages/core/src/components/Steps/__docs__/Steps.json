{
    "name": "Steps",
    "description": "Feature a series of steps in a horizontal or vertical orientation.",
    "extends": "LayoutComponent",
    "abstract": false,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "backgroundColor": {
            "type": "ThemeColor",
            "description": "Background colour keyword",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white"
            ],
            "inherited": false
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "supported": [
                "is-style-numbered",
                "is-style-simple"
            ],
            "default": [
                "steps"
            ],
            "inherited": false
        },
        "colorTheme": {
            "type": "ThemeColor",
            "description": "Colour keyword for the fill or outline colour",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white"
            ],
            "inherited": false
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant).",
            "inherited": false
        },
        "hAlign": {
            "type": "Alignment",
            "description": "Horizontal alignment, if applicable",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ],
            "default": "match-parent",
            "inherited": false
        },
        "id": {
            "type": "string",
            "description": "Unique identifier",
            "inherited": true
        },
        "isNested": {
            "type": "bool",
            "description": "Whether this component is nested inside another element; used for simplifying layout and HTML structure handling",
            "required": true,
            "default": false,
            "inherited": false
        },
        "maxPerRow": {
            "type": "int",
            "description": "The maximum number of steps to display per row when orientation is horizontal",
            "inherited": false
        },
        "orientation": {
            "type": "Orientation",
            "description": "Orientation of the component content, if applicable",
            "supported": [
                "horizontal",
                "vertical"
            ],
            "default": "vertical",
            "inherited": false
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set.",
            "required": true,
            "default": "steps",
            "inherited": false
        },
        "style": {
            "type": "array",
            "description": "Inline styles",
            "inherited": true
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "ol"
            ],
            "default": "ol",
            "inherited": true
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests",
            "inherited": true
        },
        "vAlign": {
            "type": "Alignment",
            "description": "Vertical alignment, if applicable",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ],
            "default": "match-parent",
            "inherited": false
        }
    },
    "innerComponents": {
        "type": "array<Step>",
        "description": "Inner components to be rendered within this component",
        "required": true,
        "inherited": false
    }
}