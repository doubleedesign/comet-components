{
    "name": "ContentImageBasic",
    "description": "A basic image within page content",
    "extends": "ContentImageComponent",
    "abstract": false,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "align": {
            "type": "string",
            "description": "Image alignment",
            "supported": [
                "left",
                "center",
                "right",
                "full"
            ]
        },
        "alt": {
            "type": "string",
            "description": "Alternative text",
            "required": true,
            "default": ""
        },
        "aspectRatio": {
            "type": "AspectRatio",
            "description": "Crop image to the given aspect ratio",
            "supported": [
                "4:3",
                "3:4",
                "1:1",
                "16:9",
                "9:16",
                "3:2",
                "2:3",
                "21:9",
                "2.35:1"
            ]
        },
        "caption": {
            "type": "string",
            "description": "Optional image caption (to appear below the image)"
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "supported": [
                "is-style-rounded",
                "breakout"
            ],
            "default": [
                "image",
                "image--basic"
            ]
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant)."
        },
        "height": {
            "type": "string",
            "description": "Set a fixed height for the image"
        },
        "href": {
            "type": "string",
            "description": "URL to link to"
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "scale": {
            "type": "string",
            "description": "How to handle how the image fits the available space",
            "supported": [
                "contain",
                "cover"
            ],
            "default": "contain"
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set.",
            "required": true,
            "default": "image"
        },
        "src": {
            "type": "string",
            "description": "Image source URL",
            "required": true
        },
        "style": {
            "type": "array",
            "description": "Inline styles"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "figure",
                "div"
            ],
            "default": "div"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        },
        "title": {
            "type": "string",
            "description": "Optional image title (appears on hover)"
        },
        "width": {
            "type": "string",
            "description": "Set a fixed width for the image"
        }
    }
}