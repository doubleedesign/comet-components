{
    "name": "LabelWithTooltip",
    "description": null,
    "extends": "TextElement",
    "abstract": false,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": [],
            "inherited": true
        },
        "icon": {
            "type": "string",
            "description": "Icon class name",
            "inherited": true
        },
        "iconPrefix": {
            "type": "string",
            "description": "Icon prefix class name",
            "default": "fa-solid",
            "inherited": true
        },
        "id": {
            "type": "string",
            "description": "Unique identifier",
            "inherited": true
        },
        "style": {
            "type": "array",
            "description": "Inline styles",
            "inherited": true
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "span",
                "label"
            ],
            "default": "span",
            "inherited": true
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests",
            "inherited": true
        },
        "textAlign": {
            "type": "Alignment",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ],
            "inherited": true
        },
        "tooltip": {
            "type": "string",
            "description": "The text to use in the tooltip; if not provided, the icon + tooltip will not be rendered, only the label text will",
            "required": true
        }
    },
    "content": {
        "type": "string",
        "description": "Plain text or basic HTML",
        "required": true,
        "inherited": true
    }
}