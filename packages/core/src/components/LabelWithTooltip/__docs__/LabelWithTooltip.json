{
    "name": "LabelWithTooltip",
    "description": null,
    "extends": "TextElement",
    "abstract": false,
    "isInner": false,
    "attributes": {
        "classes": {
            "type": "array<string>",
            "description": "Additional CSS classes",
            "default": []
        },
        "icon": {
            "type": "string",
            "description": "Icon class name"
        },
        "iconPrefix": {
            "type": "string",
            "description": "Icon prefix class name",
            "default": "fa-solid"
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set. If explicitly set, handling is component-specific depending on CSS requirements: some will use it in place of generic defaults, others will add a wrapper or adjust BEM classes but otherwise keep the same HTML structure.",
            "required": true,
            "default": "label-with-tooltip"
        },
        "style": {
            "type": "array",
            "description": "Inline styles"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "span",
                "label"
            ],
            "default": "span"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        },
        "textAlign": {
            "type": "Alignment",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ]
        },
        "tooltip": {
            "type": "string",
            "description": "The text to use in the tooltip; if not provided, the icon + tooltip will not be rendered, only the label text will",
            "required": true
        }
    },
    "content": {
        "type": "string",
        "description": "Plain text or basic HTML",
        "required": true
    },
    "traits": [
        "Icon",
        "ShortName",
        "TextAlign"
    ]
}