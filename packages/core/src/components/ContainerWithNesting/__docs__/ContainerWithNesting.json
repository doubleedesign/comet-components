{
    "name": "ContainerWithNesting",
    "description": null,
    "extends": "Container",
    "abstract": false,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "backgroundColors": {
            "type": "BackgroundCollection",
            "description": "Key -> value pairs of background placement and colour keywords"
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": [
                "container"
            ]
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant)."
        },
        "hAlign": {
            "type": "Alignment",
            "description": "Horizontal alignment, if applicable",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ],
            "default": "match-parent"
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "innerSize": {
            "type": "ContainerSize|mixed",
            "description": "The size of the inner container that the base container will wrap; should always be the same or smaller than the outer container size",
            "supported": [
                "fullwidth",
                "wide",
                "narrow",
                "narrower",
                "small",
                "contained"
            ]
        },
        "orientation": {
            "type": "Orientation",
            "description": "Orientation of the component content, if applicable",
            "supported": [
                "horizontal",
                "vertical"
            ],
            "default": "vertical"
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set.",
            "required": true,
            "default": "container"
        },
        "size": {
            "type": "ContainerSize",
            "description": "Keyword specifying the relative width of the container for the inner content if the component is not nested inside another layout component. Should be ignored if the component has an isNested attribute set to true, or other logic determines that it is nested.",
            "supported": [
                "fullwidth",
                "wide",
                "narrow",
                "narrower",
                "small",
                "contained"
            ],
            "default": "contained"
        },
        "style": {
            "type": "array",
            "description": "Inline styles"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "div"
            ],
            "default": "div"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        },
        "vAlign": {
            "type": "Alignment",
            "description": "Vertical alignment, if applicable",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ],
            "default": "match-parent"
        }
    },
    "innerComponents": {
        "type": "array<Renderable>",
        "description": "Inner components to be rendered within this component",
        "required": true
    },
    "traits": [
        "LayoutContainerSize",
        "LayoutOrientation",
        "BackgroundColor",
        "LayoutAlignment",
        "LayoutContainerSize",
        "BlockElementModifier"
    ]
}