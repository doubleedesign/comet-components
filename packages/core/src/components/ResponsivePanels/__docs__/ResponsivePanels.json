{
    "name": "ResponsivePanels",
    "description": "Display grouped panels of content as an Accordion or Tabs depending on available space. Uses Vue to determine which to show and only renders the HTML for the current view.",
    "extends": "PanelGroupComponent",
    "abstract": false,
    "vue": true,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "backgroundColor": {
            "type": "ThemeColor",
            "description": "Background colour keyword",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white"
            ],
            "inherited": false
        },
        "breakpoint": {
            "type": "string",
            "description": "The container breakpoint at which to switch between accordion and tabs",
            "required": true,
            "inherited": false
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": [
                "responsive-panels"
            ],
            "inherited": true
        },
        "colorTheme": {
            "type": "ThemeColor",
            "description": "Colour keyword for the fill or outline colour",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white"
            ],
            "inherited": false
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant).",
            "inherited": false
        },
        "icon": {
            "type": "string",
            "description": "Icon class name",
            "inherited": false
        },
        "iconPrefix": {
            "type": "string",
            "description": "Icon prefix class name",
            "default": "fa-solid",
            "inherited": false
        },
        "id": {
            "type": "string",
            "description": "Unique identifier",
            "inherited": true
        },
        "isNested": {
            "type": "bool",
            "description": "Whether this component is nested inside another element; used for simplifying layout and HTML structure handling",
            "required": true,
            "default": true,
            "inherited": false
        },
        "orientation": {
            "type": "Orientation",
            "description": "Orientation of the component content, if applicable",
            "supported": [
                "horizontal",
                "vertical"
            ],
            "default": "vertical",
            "inherited": false
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set.",
            "required": true,
            "default": "responsive-panels",
            "inherited": false
        },
        "size": {
            "type": "ContainerSize",
            "description": "Keyword specifying the relative width of the container for the inner content if the component is not nested inside another layout component. Ignored if the component has an isNested attribute set to true, or other logic determines that it is not nested.",
            "supported": [
                "default",
                "wide",
                "fullwidth",
                "narrow",
                "narrower",
                "small"
            ],
            "default": "default",
            "inherited": false
        },
        "style": {
            "type": "array",
            "description": "Inline styles",
            "inherited": true
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "div"
            ],
            "default": "div",
            "inherited": true
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests",
            "inherited": true
        }
    },
    "innerComponents": {
        "type": "array<ResponsivePanel>",
        "description": "Inner components to be rendered within this component",
        "required": true,
        "inherited": false
    }
}