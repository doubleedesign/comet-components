{
    "name": "Accordion",
    "description": "Group content into expandable/collapsible panels.",
    "extends": "PanelGroupComponent",
    "abstract": false,
    "vue": true,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "backgroundColor": {
            "type": "ThemeColor",
            "description": "Background colour keyword",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white",
                "black"
            ]
        },
        "beforeComponents": {
            "type": "array<Renderable>",
            "description": "Components to render before the main component (e.g. heading, intro text).",
            "required": true,
            "default": []
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": [
                "accordion"
            ]
        },
        "colorTheme": {
            "type": "ThemeColor",
            "description": "Colour keyword for theming purposes. May be used for headings, buttons, accents, and other UI elements according to the component implementation.",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white",
                "black"
            ]
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant)."
        },
        "icon": {
            "type": "string",
            "description": "Icon class name"
        },
        "iconPrefix": {
            "type": "string",
            "description": "Icon prefix class name",
            "default": "fa-solid"
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "isNested": {
            "type": "bool",
            "description": "Whether this component is nested inside another element; used for simplifying layout and HTML structure handling",
            "required": true,
            "default": false
        },
        "orientation": {
            "type": "Orientation",
            "description": "Orientation of the component content, if applicable",
            "supported": [
                "horizontal",
                "vertical"
            ],
            "default": "vertical"
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set.",
            "required": true,
            "default": "accordion"
        },
        "size": {
            "type": "ContainerSize",
            "description": "Keyword specifying the relative width of the container for the inner content if the component is not nested inside another layout component. Ignored if the component has an isNested attribute set to true, or other logic determines that it is not nested.",
            "supported": [
                "default",
                "fullwidth",
                "wide",
                "narrow",
                "narrower",
                "small"
            ],
            "default": "default"
        },
        "style": {
            "type": "array",
            "description": "Inline styles"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "div"
            ],
            "default": "div"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        }
    },
    "innerComponents": {
        "type": "array<AccordionPanel>",
        "description": "Panels to include in the accordion.",
        "required": true
    },
    "traits": [
        "Icon",
        "NestedState",
        "BackgroundColor",
        "ColorTheme",
        "LayoutContainerSize",
        "LayoutOrientation",
        "NestedState",
        "BlockElementModifier"
    ]
}