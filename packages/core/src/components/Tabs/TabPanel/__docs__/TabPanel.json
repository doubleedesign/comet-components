{
    "name": "TabPanel",
    "description": null,
    "extends": "PanelComponent",
    "abstract": false,
    "isInner": true,
    "belongsInside": "Tabs",
    "attributes": {
        "backgroundColor": {
            "type": "ThemeColor",
            "description": "The single background colour of the component.",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white",
                "black"
            ]
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": [
                "tabs__tab-panel__content"
            ]
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant).",
            "default": "tabs"
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set.",
            "required": true,
            "default": "tab-panel"
        },
        "style": {
            "type": "array",
            "description": "Inline styles"
        },
        "subtitle": {
            "type": "string"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "div"
            ],
            "default": "div"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        },
        "title": {
            "type": "string",
            "required": true
        }
    },
    "innerComponents": {
        "type": "array<Renderable>",
        "description": "Inner components to be rendered within this component",
        "required": true
    },
    "traits": [
        "BackgroundColor",
        "BlockElementModifier"
    ]
}