{
    "name": "EventList",
    "description": "*/",
    "extends": "UIComponent",
    "abstract": false,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": [
                "events__list"
            ],
            "inherited": true
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM name of the parent component or variant if contextually relevant. May be automatically set by parent component(s).",
            "inherited": true
        },
        "heading": {
            "type": "string",
            "description": "The heading for the list."
        },
        "id": {
            "type": "string",
            "description": "Unique identifier",
            "inherited": true
        },
        "maxItemsPerRow": {
            "type": "int",
            "description": "The maximum number of items to display per row, when the viewport is wide enough to accommodate.",
            "required": true,
            "default": 3
        },
        "style": {
            "type": "array",
            "description": "Inline styles",
            "inherited": true
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "ul",
                "ol"
            ],
            "default": "ul",
            "inherited": true
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests",
            "inherited": true
        }
    },
    "innerComponents": {
        "type": "array<EventCard>",
        "description": "Event cards to display.",
        "required": true
    }
}