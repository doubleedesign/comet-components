{
    "name": "EventList",
    "description": "*/",
    "extends": "UIComponent",
    "abstract": false,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": [
                "event-list"
            ],
            "inherited": true
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant).",
            "inherited": true
        },
        "heading": {
            "type": "string",
            "description": "The heading for the list.",
            "inherited": false
        },
        "id": {
            "type": "string",
            "description": "Unique identifier",
            "inherited": true
        },
        "maxItemsPerRow": {
            "type": "int",
            "description": "The maximum number of items to display per row, when the viewport is wide enough to accommodate.",
            "required": true,
            "default": 3,
            "inherited": false
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set.",
            "required": true,
            "default": "event-list",
            "inherited": true
        },
        "style": {
            "type": "array",
            "description": "Inline styles",
            "inherited": true
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "ul",
                "ol"
            ],
            "default": "ul",
            "inherited": true
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests",
            "inherited": true
        }
    },
    "innerComponents": {
        "type": "array<EventCard>",
        "description": "Event cards to display.",
        "required": true,
        "inherited": false
    }
}