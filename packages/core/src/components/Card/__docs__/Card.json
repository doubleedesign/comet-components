{
    "name": "Card",
    "description": "*/",
    "extends": "UIComponent",
    "abstract": false,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "aboveContentComponents": {
            "type": "array<Renderable>",
            "description": "Optional array of components to render above the main content; allows for things like tags, badges, etc",
            "default": []
        },
        "aspectRatio": {
            "type": "AspectRatio",
            "description": "Crop banner image to the given aspect ratio",
            "supported": [
                "4:3",
                "3:4",
                "1:1",
                "16:9",
                "9:16",
                "3:2",
                "2:3",
                "21:9",
                "2.35:1"
            ]
        },
        "backgroundColor": {
            "type": "ThemeColor",
            "description": "Background colour keyword",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white"
            ]
        },
        "bodyText": {
            "type": "string",
            "description": "Text content of the card; will be put into a paragraph; expects plain text / simple inline HTML",
            "required": true
        },
        "cardAsLink": {
            "type": "bool",
            "description": "Whether to render the entire card as a link (if a link is provided); otherwise a button will be used",
            "required": true,
            "default": "false"
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": [
                "card"
            ],
            "inherited": true
        },
        "colorTheme": {
            "type": "ThemeColor",
            "description": "Colour keyword for the fill or outline colour",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white"
            ],
            "default": "white"
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM name of the parent component or variant if contextually relevant. May be automatically set by parent component(s).",
            "inherited": true
        },
        "focalPoint": {
            "type": "array{x:",
            "description": "The focal point of the image to use when cropping - x and y values between 0 and 100",
            "default": {
                "x": 50,
                "y": 50
            }
        },
        "heading": {
            "type": "string",
            "description": "Heading text of the card; will be put into an H3 by default; expects plain text / simple inline HTML",
            "required": true
        },
        "id": {
            "type": "string",
            "description": "Unique identifier",
            "inherited": true
        },
        "image": {
            "type": "array{src:string,",
            "required": true
        },
        "isNested": {
            "type": "bool",
            "required": true,
            "default": "true"
        },
        "link": {
            "type": "array{href:string,",
            "description": "Optional link for the card",
            "required": true,
            "default": []
        },
        "offset": {
            "type": "array{x:",
            "description": "The percentage offsets of the image to use when cropping",
            "default": {
                "x": 0,
                "y": 0
            }
        },
        "orientation": {
            "type": "Orientation",
            "description": "Orientation of the component content, if applicable",
            "supported": [
                "horizontal",
                "vertical"
            ],
            "default": "standard"
        },
        "style": {
            "type": "array",
            "description": "Inline styles",
            "inherited": true
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "div",
                "article",
                "footer"
            ],
            "default": "div",
            "inherited": true
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests",
            "inherited": true
        },
        "withWrapper": {
            "type": "bool",
            "required": true,
            "default": "true"
        }
    },
    "innerComponents": {
        "type": "array<Renderable>",
        "description": "Inner components to be rendered within this component",
        "required": true,
        "inherited": true
    }
}