{
    "name": "PanelComponent",
    "description": null,
    "extends": "UIComponent",
    "abstract": true,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "backgroundColor": {
            "type": "ThemeColor",
            "description": "Background colour keyword",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white",
                "black"
            ]
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": []
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant)."
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "style": {
            "type": "array",
            "description": "Inline styles"
        },
        "subtitle": {
            "type": "string"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "div",
                "details"
            ],
            "default": "div"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        },
        "title": {
            "type": "string",
            "required": true
        }
    },
    "innerComponents": {
        "type": "array<Renderable>",
        "description": "Inner components to be rendered within this component",
        "required": true
    },
    "traits": [
        "BackgroundColor",
        "BlockElementModifier"
    ]
}