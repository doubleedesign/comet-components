{
    "name": "ContentImageComponent",
    "description": null,
    "extends": "ImageComponent",
    "abstract": true,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "align": {
            "type": "string",
            "description": "Image alignment",
            "supported": [
                "left",
                "center",
                "right",
                "full"
            ]
        },
        "alt": {
            "type": "string",
            "description": "Alternative text",
            "required": true,
            "default": ""
        },
        "aspectRatio": {
            "type": "AspectRatio",
            "description": "Crop image to the given aspect ratio",
            "supported": [
                "4:3",
                "3:4",
                "1:1",
                "16:9",
                "9:16",
                "3:2",
                "2:3",
                "21:9",
                "2.35:1"
            ]
        },
        "caption": {
            "type": "string",
            "description": "Optional image caption (to appear below the image)"
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "supported": [
                "is-style-rounded",
                "breakout"
            ],
            "default": []
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant)."
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "src": {
            "type": "string",
            "description": "Image source URL",
            "required": true
        },
        "style": {
            "type": "array",
            "description": "Inline styles"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "figure",
                "div"
            ],
            "default": "div"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        },
        "title": {
            "type": "string",
            "description": "Optional image title (appears on hover)"
        }
    },
    "traits": [
        "BlockElementModifier"
    ]
}