{
    "name": "DateComponent",
    "description": null,
    "extends": "Renderable",
    "abstract": true,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": []
        },
        "colorTheme": {
            "type": "ThemeColor",
            "description": "Colour keyword for the fill or outline colour",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white"
            ],
            "default": "primary"
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "locale": {
            "type": "string",
            "description": "The locale to be used for formatting the date.",
            "required": true,
            "default": "en_AU"
        },
        "showDay": {
            "type": "bool",
            "description": "Whether to show the day of the week.",
            "required": true,
            "default": "false"
        },
        "showYear": {
            "type": "bool",
            "description": "Whether to show the year.",
            "required": true,
            "default": "true"
        },
        "style": {
            "type": "array",
            "description": "Inline styles"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "time"
            ],
            "default": "time"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        }
    },
    "traits": [
        "ColorTheme",
        "ShortName"
    ]
}