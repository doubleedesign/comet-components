{
    "name": "ImageComponent",
    "description": null,
    "extends": "Renderable",
    "abstract": true,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "alt": {
            "type": "string",
            "description": "Alternative text",
            "required": true,
            "default": ""
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "supported": [
                "is-style-rounded",
                "breakout"
            ],
            "default": []
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant).",
            "inherited": true
        },
        "id": {
            "type": "string",
            "description": "Unique identifier",
            "inherited": true
        },
        "src": {
            "type": "string",
            "description": "Image source URL",
            "required": true
        },
        "style": {
            "type": "array",
            "description": "Inline styles",
            "inherited": true
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "figure",
                "div"
            ],
            "default": "div",
            "inherited": true
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests",
            "inherited": true
        },
        "title": {
            "type": "string",
            "description": "Optional image title (appears on hover)"
        }
    }
}