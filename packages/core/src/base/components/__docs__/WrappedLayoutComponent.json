{
    "name": "WrappedLayoutComponent",
    "description": null,
    "extends": "LayoutComponent",
    "abstract": true,
    "isInner": false,
    "belongsInside": "LayoutComponent",
    "attributes": {
        "ariaAttrs": {
            "type": "array",
            "description": "Allow for aria-* attributes to be passed down to the wrapper explicitly",
            "required": true
        },
        "backgroundColors": {
            "type": "BackgroundCollection",
            "description": "Key -> value pairs of background placement and colour keywords"
        },
        "classes": {
            "type": "array<string>",
            "description": "CSS classes",
            "default": []
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant)."
        },
        "dataAttrs": {
            "type": "array",
            "description": "Allow for data-* attributes to be passed down to the container explicitly; useful for cases that aren't worth creating a trait or shared property for (e.g., Columns uses this for data-count)",
            "required": true
        },
        "hAlign": {
            "type": "Alignment",
            "description": "Horizontal alignment, if applicable",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ],
            "default": "match-parent"
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "size": {
            "type": "ContainerSize",
            "description": "Keyword specifying the relative width of the container for the inner content if the component is not nested inside another layout component. Should be ignored if the component has an isNested attribute set to true, or other logic determines that it is nested.",
            "supported": [
                "fullwidth",
                "wide",
                "narrow",
                "narrower",
                "small",
                "contained"
            ],
            "default": "contained"
        },
        "style": {
            "type": "array",
            "description": "Inline styles"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "section",
                "main",
                "div",
                "article",
                "footer",
                "figure"
            ],
            "default": "section"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        },
        "vAlign": {
            "type": "Alignment",
            "description": "Vertical alignment, if applicable",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ],
            "default": "match-parent"
        }
    },
    "innerComponents": {
        "type": "array<Renderable>",
        "description": "Inner components to be rendered within this component",
        "required": true
    },
    "traits": [
        "BackgroundColor",
        "LayoutAlignment",
        "LayoutContainerSize",
        "BlockElementModifier"
    ]
}