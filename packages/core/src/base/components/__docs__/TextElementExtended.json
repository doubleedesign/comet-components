{
    "name": "TextElementExtended",
    "description": null,
    "extends": "TextElement",
    "abstract": true,
    "attributes": {
        "classes": {
            "type": "array<string>",
            "description": "Additional CSS classes",
            "default": []
        },
        "context": {
            "type": "string",
            "description": "The kebab-case or BEM element chain name of the parent component or variant (if contextually relevant). Note: For components that use the BEM trait, this must be set before init_bem_classes() is called for class naming to work as expected."
        },
        "id": {
            "type": "string",
            "description": "Unique identifier"
        },
        "shortName": {
            "type": "string",
            "description": "The name of the component without any namespacing, prefixes, etc. Used for BEM block/element naming. Derived from the Blade filename if not explicitly set. If explicitly set, handling is component-specific depending on CSS requirements: some will use it in place of generic defaults, others will add a wrapper or adjust BEM classes but otherwise keep the same HTML structure.",
            "required": true,
            "default": ""
        },
        "style": {
            "type": "array<string, string>",
            "description": "Inline styles"
        },
        "tagName": {
            "type": "Tag",
            "description": "The HTML tag to use for this component",
            "supported": [
                "h1",
                "h2",
                "h3",
                "h4",
                "h5",
                "h6",
                "p",
                "li",
                "button",
                "summary",
                "blockquote",
                "span",
                "em",
                "strong",
                "a",
                "i",
                "mark",
                "cite",
                "s",
                "sup",
                "sub",
                "button",
                "img",
                "wbr",
                "br",
                "time",
                "code",
                "kbd",
                "bdi",
                "bdo"
            ],
            "default": "span"
        },
        "testId": {
            "type": "string",
            "description": "Optionally add a data-testid attribute for automated tests"
        },
        "textAlign": {
            "type": "Alignment",
            "supported": [
                "start",
                "end",
                "center",
                "justify",
                "match-parent"
            ]
        }
    },
    "content": {
        "type": "string",
        "description": "Plain text or basic HTML",
        "required": true
    },
    "traits": [
        "BlockElementModifier",
        "TextAlign"
    ]
}