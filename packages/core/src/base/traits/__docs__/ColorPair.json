{
    "name": "ColorPair",
    "attributes": {
        "backgroundColor": {
            "type": "ThemeColor|ThemeGradient",
            "description": "The background colour of the component."
        },
        "colorTheme": {
            "type": "ThemeColor",
            "description": "Colour keyword for theming purposes. May be used for headings, buttons, accents, and other UI elements according to the component implementation.",
            "supported": [
                "primary",
                "secondary",
                "accent",
                "error",
                "success",
                "warning",
                "info",
                "light",
                "dark",
                "white",
                "black"
            ]
        }
    },
    "inherits": [
        "BackgroundColor",
        "ColorTheme"
    ]
}