{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "comet/upcoming-events",
	"title": "Upcoming Events",
	"icon": "calendar-alt",
	"description": "Display a list of upcoming events.",
	"category": "content",
	"textdomain": "comet",
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"blockVersion": 3,
		"hideFieldsInSidebar": true
	},
	"editorStyle": [
		"comet-event-list",
		"comet-event-card",
		"comet-date-block",
		"comet-date-range-block",
		"comet-icon-with-text",
		"comet-link-group"
	],
	"keywords": [
		"events",
		"calendar"
	],
	"attributes": {
		"size": {
			"type": "string",
			"default": "contained"
		},
		"colorTheme": {
			"type": "string",
			"default": "primary"
		},
		"maxPerRow": {
			"type": "number",
			"default": 3
		},
		"itemCount": {
			"type": "number",
			"default": 3
		},
		"hAlign": {
			"type": "string",
			"default": "start"
		}
	},
	"supports": {
		"mode": true,
		"jsx": true,
		"innerBlocks": false,
		"anchor": true,
		"ariaLabel": false,
		"align": false,
		"html": false,
		"multiple": false
	}
}
